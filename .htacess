# Ativar rewrite engine
RewriteEngine On
RewriteBase /

# Forçar HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Redirecionar www para não-www
RewriteCond %{HTTP_HOST} ^www\.coopagro\.jebisweb\.uk [NC]
RewriteRule ^(.*)$ https://coopagro.jebisweb.uk/$1 [L,R=301]

# Corrigir MIME types para evitar problemas
AddType text/css .css
AddType application/javascript .js
AddType application/x-javascript .js
AddType image/x-icon .ico
AddType image/svg+xml .svg
AddType application/x-font-woff .woff
AddType application/font-woff2 .woff2
AddType application/x-font-ttf .ttf
AddType application/vnd.ms-fontobject .eot

# CORS para fontes (IMPORTANTE para Bootstrap/icons)
<FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2)$">
    Header set Access-Control-Allow-Origin "*"
</FilesMatch>

# Cache para melhor performance
<IfModule mod_expires.c>
    ExpiresActive On
    
    # CSS e JavaScript - 1 mês
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    
    # Imagens - 1 ano
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # Fontes - 1 ano
    ExpiresByType application/x-font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    
    # HTML - 1 hora
    ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Headers de segurança
<IfModule mod_headers.c>
    # Proteção básica
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    
    # CORS para recursos externos
    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
    
    # Cache para arquivos estáticos
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    
    <FilesMatch "\.(jpg|jpeg|png|gif|ico|svg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# Permitir acesso a todos os arquivos estáticos
<Files "*.css">
    Order Allow,Deny
    Allow from all
</Files>

<Files "*.js">
    Order Allow,Deny
    Allow from all
</Files>

<Files "*.{png,jpg,jpeg,gif,ico,svg}">
    Order Allow,Deny
    Allow from all
</Files>

<Files "*.{woff,woff2,ttf,eot}">
    Order Allow,Deny
    Allow from all
</Files>

# Prevenir acesso a arquivos sensíveis
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(log|ini|conf|sql|bak|swp|env)$">
    Order allow,deny
    Deny from all
</FilesMatch>